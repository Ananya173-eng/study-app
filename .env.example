# ==============================================================================
# AI Study Hub - Environment Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DATABASE CONFIGURATION (PostgreSQL + Prisma)
# ------------------------------------------------------------------------------
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
# Compatible with: Supabase, Neon.tech, Railway, AWS RDS, Render, or Local PostgreSQL
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/aistudyhub?schema=public"

# ------------------------------------------------------------------------------
# 2. AUTHENTICATION (Auth.js / JWT Session Security)
# ------------------------------------------------------------------------------
# Strong random 32+ character secret for signing user JWT tokens
JWT_SECRET="ai-study-hub-super-secure-jwt-secret-key-2026-production"

# ------------------------------------------------------------------------------
# 3. FILE STORAGE (S3-Compatible Cloud Storage)
# ------------------------------------------------------------------------------
# Compatible with: AWS S3, Cloudflare R2, MinIO, Supabase Storage, Backblaze B2, DigitalOcean Spaces
S3_BUCKET="study-materials-bucket"
S3_REGION="us-east-1"
S3_ACCESS_KEY_ID="your-s3-access-key-id"
S3_SECRET_ACCESS_KEY="your-s3-secret-access-key"

# Optional: Custom endpoint for Cloudflare R2, MinIO, or Supabase Storage:
# - Cloudflare R2: https://<account_id>.r2.cloudflarestorage.com
# - MinIO (Local): http://127.0.0.1:9000
# - Supabase S3: https://<project_ref>.supabase.co/storage/v1/s3
# Leave empty for standard AWS S3:
S3_ENDPOINT=""

# Optional: Public CDN or custom domain for uploaded files
S3_PUBLIC_URL_PREFIX=""

# ------------------------------------------------------------------------------
# 4. AI ENGINE (Google Gemini API)
# ------------------------------------------------------------------------------
GEMINI_API_KEY="your-gemini-api-key"
